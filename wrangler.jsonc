{
  // Static site on Cloudflare Workers: serves the web/ folder, no sign-in.
  // site/worker.js runs only for /video/*, to answer the range requests video players send.
  "name": "systems-from-zero",
  "main": "site/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/video/*"]
  }
}
